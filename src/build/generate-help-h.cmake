# generate-help-h.cmake
#
# Produces help.h with the interactive (#help) and command-line (--help) help
# text compiled directly into the interpreter, so no external resource files
# are needed at runtime.
#
# Required -D arguments:
#   README_ROOT  path to the repository root README.md
#   README_CLI   path to cli/README.md
#   OUTPUT       path of the help.h file to generate
#
# Only the text between the
#   GENERATE_HELP_H_CONTENT_CLI_START ... GENERATE_HELP_H_CONTENT_CLI_END
# markers is taken from each file (the root README contributes the interactive
# command summary, cli/README contributes the command-line option summary).
# The Markdown ```text code fence inside the block is dropped.

if(NOT DEFINED README_ROOT OR NOT DEFINED README_CLI OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "README_ROOT, README_CLI and OUTPUT are required")
endif()

set(_MARK_START "GENERATE_HELP_H_CONTENT_CLI_START")
set(_MARK_END   "GENERATE_HELP_H_CONTENT_CLI_END")
string(ASCII 10 _LF)

function(uc_extract_block file outvar)
    file(READ "${file}" _content)
    string(FIND "${_content}" "${_MARK_START}" _s)
    string(FIND "${_content}" "${_MARK_END}" _e)
    if(_s LESS 0 OR _e LESS 0 OR _e LESS _s)
        message(FATAL_ERROR "help marker block not found in ${file}")
    endif()
    string(LENGTH "${_MARK_START}" _slen)
    math(EXPR _from "${_s} + ${_slen}")
    math(EXPR _len  "${_e} - ${_from}")
    string(SUBSTRING "${_content}" ${_from} ${_len} _block)
    string(REPLACE "\r" "" _block "${_block}")
    # drop the remainder of the marker-start line
    string(FIND "${_block}" "${_LF}" _nl)
    math(EXPR _nl "${_nl} + 1")
    string(SUBSTRING "${_block}" ${_nl} -1 _block)
    # drop the marker-end line prefix (text after the last newline)
    string(FIND "${_block}" "${_LF}" _nl REVERSE)
    string(SUBSTRING "${_block}" 0 ${_nl} _block)
    # drop the Markdown code fences
    string(REPLACE "\`\`\`text${_LF}" "" _block "${_block}")
    string(REPLACE "${_LF}\`\`\`" "" _block "${_block}")
    string(REPLACE "\`\`\`" "" _block "${_block}")
    set(${outvar} "${_block}" PARENT_SCOPE)
endfunction()

function(uc_to_c_literal text outvar)
    string(REPLACE "\\" "\\\\" text "${text}")
    string(REPLACE "\"" "\\\"" text "${text}")
    string(REPLACE "${_LF}" "\\n\"${_LF}\"" text "${text}")
    set(${outvar} "\"${text}\"" PARENT_SCOPE)
endfunction()

uc_extract_block("${README_ROOT}" _interactive)
uc_extract_block("${README_CLI}"  _commandline)
uc_to_c_literal("${_interactive}" _interactive_lit)
uc_to_c_literal("${_commandline}" _commandline_lit)

file(WRITE "${OUTPUT}"
"/* help.h - generated by src/build/generate-help-h.cmake, do not edit.\n"
" * Interactive help comes from README.md, command-line help from cli/README.md,\n"
" * each taken from between the GENERATE_HELP_H_CONTENT_CLI markers.\n"
" */\n"
"#ifndef UNDERC_HELP_H\n"
"#define UNDERC_HELP_H\n"
"\n"
"static const char UC_HELP_INTERACTIVE[] =\n${_interactive_lit};\n"
"\n"
"static const char UC_HELP_COMMANDLINE[] =\n${_commandline_lit};\n"
"\n"
"#endif\n")
